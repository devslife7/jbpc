# Public site origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
# Falls back to business.json "site.url" when unset.
NEXT_PUBLIC_SITE_URL=https://www.jb-premier-cleaning.com

# Optional Google Analytics 4 measurement ID override. Defaults to G-0H24D1L8V1.
NEXT_PUBLIC_GA_ID=G-0H24D1L8V1

# Search engine ownership verification tokens (optional; rendered as <meta> tags when set).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Cloudflare Turnstile keys for the contact form (see src/components/turnstile.tsx).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
